{
  "name": "aerocast-ai",
  "private": true,
  "type": "module",
  "imports": {
    "#app/*.ts": "./app/*.ts",
    "#app/*.tsx": "./app/*.tsx"
  },
  "scripts": {
    "dev": "NODE_ENV=development node --watch --import remix/node-tsx server.ts",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "hmr": "NODE_ENV=development node hmr.ts",
    "lint": "oxlint",
    "start": "NODE_ENV=production node --import remix/node-tsx server.ts",
    "test": "NODE_ENV=test remix test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "remix": "^3.1.0",
    "roughjs": "^4.6.6"
  },
  "devDependencies": {
    "@types/node": "latest",
    "maplibre-gl": "^6.16.0",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "typescript": "latest"
  },
  "engines": {
    "node": ">=26.13.0 <27"
  }
}
