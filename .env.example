# Copy to .env. .env is gitignored and never committed.
# Only the API process reads this file.

# --- API -------------------------------------------------------------------
AEROCAST_ENV=local

# Native dev against a local Postgres. A bare postgresql:// is rewritten to
# postgresql+asyncpg:// because the async engine will not infer the driver.
DATABASE_URL=postgresql://localhost:5432/aerocast

# --- Explanation service (API only) ---------------------------------------
# One pool, fastest model first. `provider/model` pins a single entry and a
# bare provider name expands to its whole ladder in place. Reorder freely:
# LLM_CHAIN=local for a fully offline demo, or put local first to prefer it.
LLM_CHAIN=gemini/gemini-3.5-flash-lite,gemini/gemini-3.6-flash,zai/glm-4.7-flash,zai/glm-4.5-flash,gemini/gemini-3.8-flash
LLM_TIMEOUT_SECONDS=20
LLM_THINKING_TIMEOUT_SECONDS=120

ZAI_API_KEY=
ZAI_BASE_URL=https://api.z.ai/api/paas/v4/
# Used when the pool names `zai` without a model. Both are free; 4.5 covers 4.7
# when it reports 1305 overload or a concurrency limit.
ZAI_MODELS=glm-4.7-flash,glm-4.5-flash

GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# Used when the pool names `gemini` without a model. Gemini 3 cannot disable
# thinking, so these differ mostly in latency.
GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.6-flash,gemini-3.8-flash
GEMINI_REASONING_EFFORT=low

# Any OpenAI-compatible server on this machine: oMLX, Ollama, LM Studio.
# Disabled by default; add "local" to LLM_CHAIN and point this at it.
LOCAL_BASE_URL=
LOCAL_MODEL=mlx-community/gemma-4-e2b-it-4bit

# --- Web -------------------------------------------------------------------
# Not read from this file. Set it in your shell, or in compose.yaml for containers.
# API_BASE_URL=http://localhost:8000
