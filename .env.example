# Copy to .env. .env is gitignored and never committed.
# Only the API process reads this file.

# --- API -------------------------------------------------------------------
AEROCAST_ENV=local

# Native dev against a local Postgres. A bare postgresql:// is rewritten to
# postgresql+asyncpg:// because the async engine will not infer the driver.
DATABASE_URL=postgresql://localhost:5432/aerocast

# --- Explanation service (API only) ---------------------------------------
# Each provider has one model list. Every rung is asked at once and the first
# reply wins; 35 s is the ceiling for the whole answer, losers included.
# Endpoints are pinned in config.py: they are not settings.

GEMINI_API_KEY=
# Gemini thinking models; low effort keeps replies inside the 35 s cap.
GEMINI_MODELS=gemini-3.5-flash-lite,gemini-4-hydrogen
GEMINI_REASONING_EFFORT=low

OPENAI_API_KEY=
# Structured outputs; low effort avoids extra reasoning latency in the race.
OPENAI_MODELS=gpt-6-luna
OPENAI_REASONING_EFFORT=low

GROQ_API_KEY=
# Fast json_object rungs; each model has its own 1k RPD / 8k TPM free pool.
GROQ_MODELS=qwen/qwen3.8-27b,openai/gpt-oss-120b
GROQ_REASONING_EFFORT=low

# --- Web -------------------------------------------------------------------
# Not read from this file. Set it in your shell, or in compose.yaml for containers.
# API_BASE_URL=http://localhost:8000
