# Copy to .env. .env is gitignored and never committed.
# Only the API process reads this file.

# --- API -------------------------------------------------------------------
AEROCAST_ENV=local

# Native dev against a local Postgres. The scheme is normalized in config.py, so
# postgres:// and postgresql:// are both accepted.
DATABASE_URL=postgresql://localhost:5432/aerocast

# --- Explanation service (API only) ---------------------------------------
# Tried left to right. Set LLM_CHAIN=mlx for a fully offline demo, or
# LLM_CHAIN=mlx,zai,gemini to prefer the local model when it is running.
LLM_CHAIN=zai,gemini,mlx
LLM_TIMEOUT_SECONDS=20

ZAI_API_KEY=
ZAI_BASE_URL=https://api.z.ai/api/paas/v4/
ZAI_MODEL=glm-4.7-flash

GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Local MLX model behind oMLX (omlx.ai) or any OpenAI-compatible MLX server.
# Apple Silicon only, so this stays empty in production. To run it:
#   uv tool install mlx-lm && mlx_lm.server --model <model>
# or start oMLX and point it at the same model id.
MLX_BASE_URL=http://127.0.0.1:8080/v1
MLX_MODEL=mlx-community/gemma-4-e2b-it-4bit

# --- Web -------------------------------------------------------------------
# Not read from this file. Set it in your shell, or in compose.yaml for containers.
# API_BASE_URL=http://localhost:8000
