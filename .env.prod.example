# Copy to .env on the VPS (never commit .env).
# Used with: docker compose -f compose.prod.yaml up -d --build
#
# AEROCAST_ENV, DATABASE_URL, and API_BASE_URL are set by compose.prod.yaml.

# --- Database (compose.prod.yaml) -----------------------------------------
POSTGRES_USER=aerocast
# Required; compose.prod.yaml refuses to start if empty (e.g. openssl rand -base64 32).
POSTGRES_PASSWORD=
POSTGRES_DB=aerocast

# --- Web (compose.prod.yaml) ----------------------------------------------
# Keep 127.0.0.1 behind Caddy, Nginx, or a Cloudflare Tunnel.
WEB_BIND=127.0.0.1
WEB_PORT=44100

# --- Explanation service (API only) ---------------------------------------
# Rungs run in EWMA latency order with a 1.5 s hedge delay and a 35 s cap.
# Endpoints are pinned in backend/app/config.py.

GEMINI_API_KEY=
# Gemini thinking models; low effort keeps replies inside the 35 s cap.
GEMINI_MODELS=gemini-3.5-flash-lite,gemini-4-hydrogen
GEMINI_REASONING_EFFORT=low

OPENAI_API_KEY=
# Structured outputs; low effort avoids extra reasoning latency.
OPENAI_MODELS=gpt-6-luna
OPENAI_REASONING_EFFORT=low

GROQ_API_KEY=
# Fast json_object rungs; each model has its own 1k RPD / 8k TPM free pool.
GROQ_MODELS=qwen/qwen3.8-27b,openai/gpt-oss-120b
GROQ_REASONING_EFFORT=low
